<Window x:Class="project_docs_summariser.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:project_docs_summariser"
        mc:Ignorable="d"
        Title="Settings" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#E0E0E0" FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0098FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="SETTINGS" FontSize="24" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,25"/>

            <TextBlock Text="Groq API Key" Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                <PasswordBox x:Name="ApiKeyInput" Width="300" Height="35" Background="#2D2D30" Foreground="White" BorderThickness="1" BorderBrush="#3F3F46" Padding="8,5" VerticalContentAlignment="Center"/>
                <Button Content="SAVE KEY" Height="35" Margin="15,0,0,0" Click="SaveKey_Click"/>
            </StackPanel>

            <TextBlock Text="Preferences" Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
            <CheckBox x:Name="DisableAnimationsCheckBox"
                      Content="Disable Animations"
                      FontSize="14"
                      Margin="0,5,0,0"
                      Foreground="#E0E0E0"
                      Click="DisableAnimationsCheckBox_Click"/>
        </StackPanel>
    </Grid>
</Window>