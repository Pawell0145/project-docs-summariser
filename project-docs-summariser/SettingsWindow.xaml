<Window x:Class="project_docs_summariser.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:project_docs_summariser"
        mc:Ignorable="d"
        Title="Settings" Height="600" Width="800"
        Background="#1E1E1E" Foreground="#E0E0E0" FontFamily="Segoe UI">
    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="SETTINGS" FontSize="22" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,20"/>
            <CheckBox x:Name="DisableAnimationsCheckBox"
                      Content="Disable Animations"
                      FontSize="14"
                      Margin="0,5,0,0"
                      Foreground="#E0E0E0"
                      Click="DisableAnimationsCheckBox_Click"/>
        </StackPanel>
    </Grid>
</Window>
