<Window x:Class="WpfAiIntegration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Document Summariser" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>
        <!-- COLOR PALETTE -->
        <SolidColorBrush x:Key="PrimaryActionBrush" Color="#4F46E5"/>
        <SolidColorBrush x:Key="PrimaryActionHoverBrush" Color="#4338CA"/>
        <SolidColorBrush x:Key="SecondaryActionBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="SecondaryActionHoverBrush" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>

        <!-- Modern Button Style -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="{StaticResource PrimaryActionBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryActionHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#9CA3AF"/>
                                <Setter Property="Foreground" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary/Outline Button Style -->
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SecondaryActionBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource SecondaryActionHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tool Button Style (For icons in panels) -->
        <Style TargetType="Button" x:Key="ToolButton" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>

        <!-- Style for individual file items with delete button -->
        <Style TargetType="ListBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" Padding="8,4" SnapsToDevicePixels="true" Background="Transparent" CornerRadius="4" Margin="0,0,0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- File Icon -->
                                <Path Width="12" Height="16" Fill="{StaticResource TextSecondaryBrush}" Stretch="Fill" Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" Margin="0,0,8,0"/>

                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>

                                <!-- Delete Button -->
                                <Button Grid.Column="2" x:Name="RemoveFileButton" Click="RemoveFileButton_Click" ToolTip="Remove file" Background="Transparent" BorderThickness="0" Cursor="Hand" Opacity="0" Margin="5,0,0,0">
                                    <Path Width="10" Height="10" Fill="#EF4444" Stretch="Fill" Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#F9FAFB"/>
                                <Setter TargetName="RemoveFileButton" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <!-- Status Bar -->
        </Grid.RowDefinitions>

        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: File Management Card -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.03" BlurRadius="15" ShadowDepth="1"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Source Documents" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                    <TextBlock Text="Select or drag text files to summarize." Grid.Row="1" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                    <!-- ScrollViewer around ListBox to manage drop visual -->
                    
                    <Grid Grid.Row="2" Margin="0,0,0,15">
                        <Border x:Name="FileListBoxBorder" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="White">
                            <ListBox x:Name="FileListBox" Background="Transparent" BorderThickness="0" Padding="5" Foreground="#4B5563" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Margin="0,5"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </Border>

                        <!-- Empty State Placeholder (Visible when no files) -->
                        <StackPanel x:Name="PlaceholderVisual" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Path Width="48" Height="48" Fill="#E5E7EB" Stretch="Fill" Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M16,11V18H8V11H16M14,13H10V16H14V13Z" Margin="0,0,0,15"/>
                            <TextBlock Text="Drag files here" FontWeight="SemiBold" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                            <TextBlock Text="or use the button below" FontSize="12" Foreground="#D1D5DB" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SelectFileButton" Content="Add Files..." Click="SelectFileButton_Click" Style="{StaticResource SecondaryButton}" Grid.Column="0"/>
                        <Button x:Name="ClearButton" Content="Clear All" Click="ClearButton_Click" Style="{StaticResource SecondaryButton}" Grid.Column="2"/>
                    </Grid>

                    <Button x:Name="SendButton" Grid.Row="4" Click="SendButton_Click" Style="{StaticResource ModernButton}" Padding="15" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Fill="White" Stretch="Fill" Data="M9.81,15.15L11.41,16.75L14.41,13.75L15.81,15.15L11.41,19.55L8.41,16.55L9.81,15.15M19,3H5C3.89,3 3,3.89 3,5V19C3,20.1 3.89,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19M13.73,8H7V9.5H13.73L13,10.23V11L14.5,9.5L13,8V8.77M17,11.5L15.5,10L14,11.5V10.73L14.73,10H17V11.5Z" Margin="0,0,10,0"/>
                            <TextBlock Text="Generate AI Summary"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: AI Output Card -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.03" BlurRadius="15" ShadowDepth="1"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header with Actions -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="AI Generated Summary" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="CopyButton" Click="CopyButton_Click" Style="{StaticResource ToolButton}" ToolTip="Copy to Clipboard" Visibility="Collapsed">
                                <Path Width="14" Height="16" Fill="#4B5563" Stretch="Fill" Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"/>
                            </Button>
                            <Button x:Name="SaveButton" Click="SaveButton_Click" Style="{StaticResource ToolButton}" ToolTip="Save to File" Visibility="Collapsed">
                                <Path Width="16" Height="16" Fill="#4B5563" Stretch="Fill" Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="LoadingProgress" Grid.Row="1" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,15" Foreground="{StaticResource PrimaryActionBrush}" Background="#EEF2FF" BorderThickness="0"/>

                    <Border Grid.Row="2" Background="#F9FAFB" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15">
                        <TextBox x:Name="OutputTextBox" 
                                 TextWrapping="Wrap" IsReadOnly="True" 
                                 VerticalScrollBarVisibility="Auto" 
                                 Background="Transparent" BorderThickness="0" 
                                 FontSize="14" Foreground="#374151" 
                                 Text="Your summary will appear here after clicking 'Generate Summary'..."
                                 AcceptsReturn="True"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <StatusBar Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,5">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusTextBlock" Text="Ready" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="{StaticResource BorderBrush}"/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Powered by Groq | LLaMA 3.3" Foreground="#D1D5DB" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>