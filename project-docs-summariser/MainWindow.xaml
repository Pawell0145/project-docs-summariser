<Window x:Class="WpfAiIntegration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Document Summariser" Height="750" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>
        <!-- DYNAMIC COLOR PALETTE (Allows for Dark Mode) -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="White"/>
        <SolidColorBrush x:Key="PrimaryActionBrush" Color="#4F46E5"/>
        <SolidColorBrush x:Key="PrimaryActionHoverBrush" Color="#4338CA"/>
        <SolidColorBrush x:Key="SecondaryActionBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="SecondaryActionHoverBrush" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#99000000"/>

        <!-- Fix for ComboBox Dropdown Popups in Dark Mode -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SecondaryActionBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Button Style -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryActionHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SecondaryActionBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Top Nav Button -->
        <Style TargetType="Button" x:Key="NavButton" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Main Content -->
            <RowDefinition Height="Auto"/>
            <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- HEADER (Toolbar) -->
        <Grid Grid.Row="0" Margin="20,10,20,0">
            <TextBlock Text="DocuMind AI" FontSize="22" FontWeight="Black" Foreground="{DynamicResource PrimaryActionBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="HistoryButton_Click" Style="{StaticResource NavButton}" ToolTip="View History">
                    <TextBlock Text="🕒 History" FontSize="14"/>
                </Button>
                <Button Click="ThemeToggle_Click" Style="{StaticResource NavButton}" ToolTip="Toggle Dark Mode">
                    <TextBlock Text="🌓 Theme" FontSize="14"/>
                </Button>
                <Button Click="SettingsButton_Click" Style="{StaticResource NavButton}" ToolTip="Settings">
                    <TextBlock Text="⚙️ Settings" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Source Documents" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                    <TextBlock Text="Select or drag files (.txt, .pdf, .docx)" Grid.Row="1" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,15"/>

                    <Border x:Name="FileListBoxBorder" Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Background="Transparent">
                        <Grid>
                            <ListBox x:Name="FileListBox" Background="Transparent" BorderThickness="0" Padding="5" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" Padding="8,6" Background="{TemplateBinding Background}" CornerRadius="4" Margin="0,0,0,2">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="true">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SecondaryActionBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="📄" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Click="RemoveFileButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="Red" Content="❌" Padding="5"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="PlaceholderVisual" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="📂" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="Drag files here" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SelectFileButton" Content="Add Files" Click="SelectFileButton_Click" Style="{StaticResource SecondaryButton}" Grid.Column="0"/>
                        <Button x:Name="ClearButton" Content="Clear All" Click="ClearButton_Click" Style="{StaticResource SecondaryButton}" Grid.Column="2"/>
                    </Grid>

                    <!-- CUSTOMIZATION PANEL -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,15">
                        <TextBlock Text="Summary Style:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>

                        <!-- Fixed ComboBox: Hardcoded text/bg colors bypass the WPF Popup bug -->
                        <ComboBox x:Name="StyleComboBox" SelectedIndex="0" Padding="8" Margin="0,0,0,10" 
                                  Background="White" Foreground="Black" BorderBrush="{DynamicResource BorderBrush}">
                            <ComboBoxItem Content="Bullet Points" Foreground="Black" Background="White"/>
                            <ComboBoxItem Content="Detailed Paragraphs" Foreground="Black" Background="White"/>
                            <ComboBoxItem Content="Executive Summary" Foreground="Black" Background="White"/>
                            <ComboBoxItem Content="Explain Like I'm 5" Foreground="Black" Background="White"/>
                        </ComboBox>

                        <TextBlock Text="Length:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="LengthComboBox" SelectedIndex="1" Padding="8" 
                                  Background="White" Foreground="Black" BorderBrush="{DynamicResource BorderBrush}">
                            <ComboBoxItem Content="Short &amp; Concise" Foreground="Black" Background="White"/>
                            <ComboBoxItem Content="Standard" Foreground="Black" Background="White"/>
                            <ComboBoxItem Content="Long &amp; Detailed" Foreground="Black" Background="White"/>
                        </ComboBox>
                    </StackPanel>

                    <Button x:Name="SendButton" Grid.Row="5" Click="SendButton_Click" Style="{StaticResource ModernButton}" Content="✨ Generate AI Summary" IsEnabled="False"/>
                </Grid>
            </Border>

            <!-- RIGHT PANEL -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="AI Generated Summary" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="CopyButton" Click="CopyButton_Click" Style="{StaticResource SecondaryButton}" Content="📋 Copy" Padding="10,5" Visibility="Collapsed" Margin="0,0,5,0"/>
                            <Button x:Name="SaveButton" Click="SaveButton_Click" Style="{StaticResource SecondaryButton}" Content="💾 Save" Padding="10,5" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="LoadingProgress" Grid.Row="1" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,15" Foreground="{DynamicResource PrimaryActionBrush}" Background="{DynamicResource SecondaryActionBrush}" BorderThickness="0"/>

                    <Border Grid.Row="2" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15">
                        <TextBox x:Name="OutputTextBox" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Text="Your summary will appear here..." AcceptsReturn="True"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <StatusBar Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,5">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Ready" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ============================================== -->
        <!-- OVERLAYS (Hidden by Default, high Z-Index)     -->
        <!-- ============================================== -->

        <!-- SETTINGS OVERLAY -->
        <Grid x:Name="SettingsOverlay" Grid.RowSpan="3" Background="{DynamicResource OverlayBackgroundBrush}" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Width="400" Height="250" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="25">
                <StackPanel>
                    <TextBlock Text="⚙️ Application Settings" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                    <TextBlock Text="Groq API Key:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="ApiKeyTextBox" Padding="10" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,5"/>
                    <TextBlock Text="Get your free key at console.groq.com" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,30"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Cancel" Click="CloseSettings_Click" Style="{StaticResource SecondaryButton}" Grid.Column="0"/>
                        <Button Content="Save Key" Click="SaveSettings_Click" Style="{StaticResource ModernButton}" Grid.Column="2"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- HISTORY OVERLAY -->
        <Grid x:Name="HistoryOverlay" Grid.RowSpan="3" Background="{DynamicResource OverlayBackgroundBrush}" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Width="600" Height="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="🕒 Summary History" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>

                    <ListBox x:Name="HistoryListBox" Grid.Row="1" Background="{DynamicResource AppBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,20"
                             SelectionChanged="HistoryListBox_SelectionChanged" Cursor="Hand">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5,5,5,15">
                                    <TextBlock Text="{Binding DateString}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding FileNames}" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,5"/>
                                    <TextBlock Text="{Binding Excerpt}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Content="Close History" Click="CloseHistory_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Width="120"/>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>