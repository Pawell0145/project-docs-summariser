<Window x:Class="WpfAiIntegration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FAST CRAM" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#E0E0E0" FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#4A4A4A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2D2D30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0098FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#FF6B6B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1" BorderBrush="#FF6B6B">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FF6B6B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#CC0000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3e3e42"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="#4A4A4A" CornerRadius="3" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#686868"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid MouseDown="Window_MouseDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#252526" BorderBrush="#333337" BorderThickness="0,0,2,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="MENU" FontWeight="Bold" FontSize="18" Margin="0,10,0,20" Foreground="#007ACC" HorizontalAlignment="Center"/>
                    <TextBlock Text="Saved Study Plans:" Foreground="#AAAAAA" Margin="5,0,0,10"/>
                </StackPanel>

                <ListBox x:Name="ProjectListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="White" DisplayMemberPath="DisplayTitle" MouseDoubleClick="ProjectListBox_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Hidden" SelectionChanged="ProjectListBox_SelectionChanged"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="DASHBOARD" FontSize="28" FontWeight="Bold" Foreground="#007ACC" HorizontalAlignment="Left"/>
                <Button Content="SETTINGS" Width="100" Height="34" Style="{StaticResource ModernButton}" HorizontalAlignment="Right" Click="OpenSettings_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Border x:Name="WelcomePanel" Background="#2D2D30" CornerRadius="8" BorderBrush="#3F3F46" BorderThickness="1" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Welcome to AI-Academic-Sync!" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Select a project from the menu to see details,&#x0a;or create a new plan to start learning." FontSize="15" Foreground="#AAAAAA" TextAlignment="Center" LineHeight="22"/>
                    </StackPanel>
                </Border>

                <Border x:Name="DetailsPanel" Background="#1E1E1E" CornerRadius="8" BorderBrush="#333337" BorderThickness="1" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <Grid Margin="25,25,25,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="DetailTitle" Grid.Row="0" Text="PROJECT TITLE" FontSize="38" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,30" TextTrimming="CharacterEllipsis"/>

                            <Grid Grid.Row="1" Margin="0,0,0,35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,50,0">
                                    <TextBlock Text="TOTAL DAYS" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="DetailTotalDays" Text="10" FontSize="32" FontWeight="Light" Foreground="#D4D4D4"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,50,0">
                                    <TextBlock Text="HOURS/DAY" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="DetailHours" Text="2h" FontSize="32" FontWeight="Light" Foreground="#D4D4D4"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="CREATED ON" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="DetailDate" Text="2024-05-10" FontSize="32" FontWeight="Light" Foreground="#D4D4D4"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="2" Margin="0,0,0,35">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="PROGRESS" FontSize="11" FontWeight="Bold" Foreground="#888888" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    <TextBlock x:Name="DetailProgressCountText" Text="2 / 20" FontSize="20" FontWeight="Bold" Foreground="#28A745" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>

                                <Grid Height="10">
                                    <Border Background="#2D2D30" CornerRadius="5"/>
                                    <Border x:Name="ProgressBarFill" Background="#28A745" CornerRadius="5" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                            </StackPanel>

                            <Border Grid.Row="3" Background="Transparent" BorderBrush="#333337" BorderThickness="4,0,0,0" Padding="15,5,0,5" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="NOTES &amp; PREFERENCES" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="DetailNotes" Text="No custom notes for this project." FontSize="14" Foreground="#AAAAAA" TextWrapping="Wrap" MaxHeight="120" FontStyle="Italic"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Button Content="DELETE" Width="120" Height="42" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Click="DeleteProject_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OPEN" Width="120" Height="42" Margin="0,0,15,0" Style="{StaticResource ModernButton}" Click="OpenProject_Click"/>
                    <Button Content="CREATE" Width="120" Height="42" Style="{StaticResource PrimaryButton}" Click="OpenCreateDialog_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>