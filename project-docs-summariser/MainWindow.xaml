<Window x:Class="WpfAiIntegration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Summariser" Height="450" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="InputTextBox" 
                 Grid.Row="0" 
                 TextWrapping="Wrap" 
                 AcceptsReturn="True" 
                 Margin="0,0,0,10" />

        <Button x:Name="SendButton" 
                Grid.Row="1" 
                Content="Send" 
                Click="SendButton_Click" 
                Padding="10,5" 
                Margin="0,0,0,10"
                FontWeight="Bold"/>

        <TextBox x:Name="OutputTextBox" 
                 Grid.Row="2" 
                 TextWrapping="Wrap" 
                 IsReadOnly="True" 
                 VerticalScrollBarVisibility="Auto" 
                 Background="#F0F0F0"/>
    </Grid>
</Window>