<Window x:Class="project_docs_summariser.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daily Quiz" Height="500" Width="700"
        WindowStartupLocation="CenterScreen" 
        Background="#1E1E1E" Foreground="#E0E0E0" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="QuizOptionStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="15" LineHeight="20"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#3F3F46" BorderThickness="2" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                                <Setter Property="BorderBrush" Value="#005A9E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <Grid>
                                <Border x:Name="HoverOverlay" Background="White" Opacity="0" CornerRadius="5"/>

                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.15"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">

        <Grid x:Name="QuizStartGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock x:Name="CurrentQuesTitle" Text="1# QUESTION" FontWeight="Bold" Foreground="BurlyWood" FontSize="26" VerticalAlignment="Center"/>
                <Button x:Name="NextQuestionBtn" Content="NEXT" Width="90" Height="35" HorizontalAlignment="Right" Background="#007ACC" Click="NextQuestionBtn_Click"/>
            </Grid>

            <TextBlock x:Name="QuestionTextBlock" Grid.Row="1" Text="Question" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,20" Foreground="#D4D4D4"/>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="OptionA" Grid.Row="0" Grid.Column="0" Content="A. " Style="{StaticResource QuizOptionStyle}" FontSize="16"/>
                <RadioButton x:Name="OptionB" Grid.Row="0" Grid.Column="1" Content="B. " Style="{StaticResource QuizOptionStyle}" FontSize="16"/>
                <RadioButton x:Name="OptionC" Grid.Row="1" Grid.Column="0" Content="C. " Style="{StaticResource QuizOptionStyle}" FontSize="16"/>
                <RadioButton x:Name="OptionD" Grid.Row="1" Grid.Column="1" Content="D. " Style="{StaticResource QuizOptionStyle}" FontSize="16"/>
            </Grid>

            <ProgressBar x:Name="QuizProgressBar" Grid.Row="3" Height="12" Margin="0,20,0,0" Value="0" Maximum="100" Foreground="#28A745" Background="#2D2D30" BorderThickness="0"/>
        </Grid>

        <Grid x:Name="QuizResultGrid" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <TextBlock x:Name="ResultTitle" Text="CONGRATULATION!" FontSize="36" FontWeight="Bold" Foreground="#28A745" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="YOUR SCORE" FontSize="20" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ResultScore" Text="8 / 10" FontSize="48" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,50"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="TryAgainBtn" Click="TryAgain" Content="TRY AGAIN" Width="120" Height="40" Margin="10,0" Background="#4A4A4A"/>
                    <Button x:Name="YourAnswersBtn" Click="YourAnswers"  Content="YOUR ANSWERS" Width="140" Height="40" Margin="10,0" Background="#4A4A4A"/>
                    <Button x:Name="FinishQuizBtn" Click="FinishQuiz" Content="NEXT" Width="120" Height="40" Margin="10,0" Background="#28A745"/>
                </StackPanel>

            </StackPanel>
        </Grid>

    </Grid>
</Window>