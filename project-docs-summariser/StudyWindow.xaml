<Window x:Class="project_docs_summariser.StudyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Study Mode" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#E0E0E0" FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#252526" BorderBrush="#333337" BorderThickness="0,0,2,0">
            <StackPanel>
                <Button Content="☰ AI Menu" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="16" FontWeight="Bold" Margin="0,10,0,10"/>

                <ListBox x:Name="DaysSidebarList" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" SelectionChanged="DaysSidebarList_SelectionChanged">
                </ListBox>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="CurrentDayTitle" Grid.Row="0" Text="DAY #1" FontSize="28" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="StudyContentText" TextWrapping="Wrap" FontSize="16" LineHeight="24" Foreground="#D4D4D4">
                    Tutaj pojawi się treść wygenerowana przez AI... 
                    Zostanie ona ładnie sformatowana, a tekst będzie można swobodnie przewijać w dół, jeśli będzie go dużo.
                </TextBlock>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>